{
  "name": "ink-wanderer",
  "displayName": "墨境行者",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:sites": "SITES_REQUIRE_HOSTING=1 bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "art:s05": "node scripts/compose-s05-layers.mjs",
    "art:s06": "node scripts/compose-s06-layers.mjs",
    "art:s07": "node scripts/compose-s07-layers.mjs",
    "art:s08": "node scripts/compose-s08-layers.mjs",
    "art:s09:entry-fix": "node scripts/fix-s09-entry-height.mjs",
    "art:s10": "node scripts/compose-s10-layers.mjs",
    "art:s11": "node scripts/compose-s11-layers.mjs",
    "art:s12": "node scripts/compose-s12-layers.mjs",
    "art:s04-underground": "node scripts/compose-s04-underground-layers.mjs",
    "art:s05-underground": "node scripts/compose-s05-underground-layers.mjs",
    "art:s06-underground": "node scripts/compose-s06-underground-layers.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
